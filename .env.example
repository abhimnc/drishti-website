# From Supabase → Project Settings → API. VITE_* values are baked in at build time, so set them before `npm run build`.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="YOUR-PROJECT"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT"
# Only needed when running `npm run db:migrate` (Supabase → Connect → Session pooler connection string).
DATABASE_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Port the Node server listens on.
PORT=3000
SUPABASE_SECRET_KEY="sb_secret_..."  # only for scripts/create-publisher.mjs; never expose it to the browser
